NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://construction_app:change-me@db:3306/construction_platform
JWT_SECRET=replace-with-a-long-random-secret
UPLOAD_DIR=/app/uploads
AUDIT_DIR=/app/audit
TRUST_PROXY=false
ALLOWED_ORIGINS=https://app.example.com
APP_URL=https://app.example.com
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRICE_PLAN_FREE=price_replace-me
STRIPE_PRICE_PLAN_BUSINESS=price_replace-me
# Sender address for every transactional email (verification, password
# reset, invitations). The domain part MUST be verified in Resend first —
# see "Transactional email" in DEPLOY.md. No default is applied in code.
EMAIL_FROM=Northline <no-reply@your-domain.example>
# Resend API key, server-side only. Replace with a real key in `.env`;
# never write a real key into this file — it ships in the release archive.
RESEND_API_KEY=replace-with-resend-api-key
STORAGE_BACKEND=s3
S3_BUCKET=northline-production
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX_ATTEMPTS=10
LOGIN_RATE_BLOCK_MS=900000

# --- Observability -----------------------------------------------------------
# Log verbosity: debug | info | warn | error (default info). Records are JSON.
LOG_LEVEL=info
# Bearer token required to scrape /metrics. Outside production /metrics is
# open; in production it is served only when this is set, otherwise 404.
METRICS_TOKEN=
# Sentry DSN. When set, unhandled errors are forwarded to Sentry in addition
# to the structured log. Leave empty to keep errors in the local ring only.
SENTRY_DSN=

MARIADB_DATABASE=construction_platform
MARIADB_USER=construction_app
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=replace-root-password
