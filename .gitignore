node_modules
dist
dist-server

# Secrets live in `.env` only. `.env.example` is a committed template and
# must keep placeholders — it ships in the release archive.
.env
.env.*
!.env.example

uploads
audit
*.log

# Generated by the harnesses, never source. Playwright writes traces and
# failure screenshots to `test-results/` (and an HTML report, if enabled), and
# `scripts/backup-db.sh` defaults `BACKUP_DIR` to `./backups` — committing
# that directory would commit a database dump, which is exactly what the
# `.env` rules above exist to prevent.
test-results/
playwright-report/
backups/
